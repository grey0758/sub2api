[Unit]
Description=Sub2API access-only native Codex broker over restricted SSH
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /opt/sub2api-native-codex/socket_bridge.py
User=root
UMask=0077
RuntimeDirectory=sub2api-native-codex
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/sub2api-native-codex
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
